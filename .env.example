OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Mail.ru SMTP (из практики MailCheque: ящик mail.ru + пароль приложения)
# IMAP там был imap.mail.ru:993; для отправки дайджеста нужен SMTP:
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
# Альтернатива: SMTP_PORT=587 (STARTTLS)
SMTP_USERNAME=your_login@mail.ru
SMTP_PASSWORD=
EMAIL_FROM=your_login@mail.ru
# Один или несколько адресов через запятую
EMAIL_TO=your_login@mail.ru

# Digest schedule defaults live in config/sources.json:
# timezone=Asia/Shanghai, schedule_hour=8

# Optional override; dashboard config/sources.json is primary for fetch proxy
HTTPS_PROXY=socks5h://127.0.0.1:12335
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
